# Supabase — public project settings. Never add the service-role key to this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public production URL, used by PWA metadata and OpenRouter attribution.
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Zym Coach — server-only.
OPENROUTER_API_KEY=
# The Zym Coach has a closed free-only model list in code.
